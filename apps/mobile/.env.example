# Copy this file to .env in this folder (never commit .env).
# Public values only: the publishable key is safe in the app because RLS protects the data.
# The secret / service_role key must NEVER appear here or in the app (Edge Functions only).

# Local Supabase: values printed by `pnpm db:start` (API URL and Publishable key).
# Keep 127.0.0.1: on a real phone the app points it to your computer automatically.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_KEY=
