# Copy this file to .env (never commit .env).
# Public values only: the anon key is safe in the app because RLS protects the data.
# The service_role key must NEVER appear here or in the app (Edge Functions only).

# Supabase (local values are printed by `pnpm db:start`)
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
